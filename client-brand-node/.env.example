# ==============================================================================
# Client Brand Node — Variáveis de Ambiente (VPS do Cliente)
# ==============================================================================

# Domínio raiz do cliente (o site novo substitui o antigo em @ e www)
DOMAIN=auroracafe.com.br

# Segredo compartilhado com /agency-master-admin para telemetria e suspensão remota
AGENCY_HEARTBEAT_SECRET=dev-agency-heartbeat-secret-2026

# Chave AES-256-GCM para criptografar a chave OpenRouter do cliente no servidor
NODE_ENCRYPTION_KEY=client-node-aes256-secret-key-32-chars

# Login padrão do Portal do Cliente (marca.{DOMAIN})
PORTAL_CLIENT_EMAIL=equipe@auroracafe.com.br
PORTAL_CLIENT_PASSWORD=MarcaAurora2026!

# Modelo padrão na OpenRouter (Contexto Longo de 1M tokens — sem AnythingLLM)
DEFAULT_AI_MODEL=google/gemini-2.5-flash
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# PocketBase interno
POCKETBASE_URL=http://pocketbase:8090

# Backups em 3 camadas (rclone)
BACKUP_RETENTION_DAYS=7
AGENCY_R2_REMOTE=agency-r2:brand-backups
CLIENT_CLOUD_REMOTE=client-drive:Brand-AI-Backup
UPTIME_KUMA_PUSH_URL=
