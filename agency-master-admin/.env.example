# ==============================================================================
# Agency Master Admin — Variáveis de Ambiente
# ==============================================================================

# Domínio do Painel Mestre (ex: admin.suaagencia.com.br)
ADMIN_DOMAIN=admin.suaagencia.com.br

# Autenticação do Painel Mestre
ADMIN_PANEL_USER=admin@suaagencia.com.br
ADMIN_PANEL_PASSWORD=TroqueEstaSenhaForte2026!

# Chave de criptografia AES-256-GCM (32+ caracteres) para proteger secrets
MASTER_ENCRYPTION_KEY=brand-ai-master-secret-key-32-chars-min

# PocketBase interno
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_ADMIN_EMAIL=admin@suaagencia.com.br
POCKETBASE_ADMIN_PASSWORD=TroqueEstaSenhaPB2026!

# Integração com Coolify API (no Servidor Mestre)
COOLIFY_API_URL=http://host.docker.internal:8000/api/v1
COOLIFY_API_TOKEN=coloque-seu-token-api-do-coolify-aqui

# URL pública do Client Brand Node de demonstração (para links da Landing Page e Telemetria na Vercel)
NEXT_PUBLIC_DEMO_NODE_URL=http://localhost:3002
LOCAL_NODE_FALLBACK_URL=http://localhost:3002
